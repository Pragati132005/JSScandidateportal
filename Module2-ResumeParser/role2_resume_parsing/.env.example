# LLM API Keys
GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Provider Configuration
# Comma-separated order of providers to try: gemini, groq, openrouter
LLM_PROVIDER_ORDER=gemini,groq,openrouter

# Per-Provider Model IDs (configurable, do not hardcode)
# Model IDs change often; scripts/list_models.py shows what a key can use.
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Operational Mode: live | replay | mock
LLM_MODE=replay

# Per-call timeout in seconds
LLM_TIMEOUT_S=30

# FastAPI service configuration
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
